# ==============================================================================
# RAKT-SETU — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env (or server/.env) and populate with your environment values.
# NEVER commit the actual .env file containing secrets to version control.
# ==============================================================================

# Application Port
PORT=5000

# Runtime Environment: development | production | test
NODE_ENV=development

# Primary MongoDB Connection URI
# In development: defaults to mongodb://127.0.0.1:27017/raktsetu
# In production: must be a valid MongoDB Atlas or dedicated replica set URI
MONGODB_URI=mongodb://127.0.0.1:27017/raktsetu

# JSON Web Token Secret Key
# Production requirement: MUST be a high-entropy string (minimum 32 characters)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_secure_random_jwt_secret_key_minimum_32_characters

# JWT Expiration Period (e.g., 7d, 24h, 3600s)
JWT_EXPIRES_IN=7d

# Permitted Client Origins for CORS (comma-separated for multiple origins)
# Example: https://raktsetu.org,https://admin.raktsetu.org
CORS_ORIGIN=http://localhost:5000

# File Upload Configuration
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=src/uploads

# Storage Provider: 'local' (default) or 's3' (for cloud persistent storage)
STORAGE_PROVIDER=local

# AWS / S3-Compatible Cloud Storage Configuration (Required if STORAGE_PROVIDER=s3)
# S3_BUCKET_NAME=raktsetu-documents
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=your_aws_access_key
# S3_SECRET_ACCESS_KEY=your_aws_secret_key
# S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
